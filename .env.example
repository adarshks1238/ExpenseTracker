# Copy this file to ".env" and fill in your own values.
# The real ".env" file is ignored by Git, so your password is never uploaded.

# MongoDB connection
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=expense_tracker

# Leave username/password empty if your local MongoDB has no authentication.
MONGO_USERNAME=
MONGO_PASSWORD=
MONGO_AUTH_SOURCE=admin

# Currency symbol shown in the app
CURRENCY_SYMBOL=₹
